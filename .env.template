# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Project Settings -> API). Public by design: RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon or publishable key>

# Public origin: sign-in redirects, share links, the certificate QR code.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Empty (the default) shows only the MVP areas (src/lib/scope.ts); "full" shows everything.
NEXT_PUBLIC_TECHMOOD_SCOPE=

# TechMood AI (server only, no NEXT_PUBLIC_ prefix on purpose). Empty = the
# assistant works but says nothing is connected.
ANTHROPIC_API_KEY=
